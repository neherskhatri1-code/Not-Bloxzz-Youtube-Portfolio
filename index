      .intro { margin-inline: auto; }
      .actions, .meta { justify-content: center; }
      .visual { min-height: 400px; grid-row: 1; }
      .orb { width: min(350px, 82vw); }
      .avatar-card { width: min(310px, 76vw); }
      .tag-top { right: 2%; } .tag-bottom { left: 1%; }
      .section-head { align-items: start; flex-direction: column; }
      .cards { grid-template-columns: 1fr; }
      .card { min-height: auto; }
      .about-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      main { width: min(100% - 28px, 1120px); }
      nav { width: calc(100% - 28px); }
      h1 { font-size: clamp(3.2rem, 16vw, 4.5rem); }
      .visual { min-height: 340px; }
