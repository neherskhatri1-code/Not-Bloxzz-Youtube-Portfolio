    .stat strong { display: block; color: var(--red); font-size: 1.2rem; margin-bottom: 4px; }
    .stat span { color: #8e8588; font-size: .74rem; }
    .social-list { display: grid; gap: 12px; }
    .social { display: flex; align-items: center; justify-content: space-between; gap: 14px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.025); border-radius: 14px; padding: 15px 17px; transition: .2s; }
    .social:hover { border-color: var(--line); transform: translateX(3px); }
    .social .left { display: flex; align-items: center; gap: 12px; }
    .social .icon { width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; background: #ff263815; color: var(--red); font-weight: 900; }
    .social strong { display: block; font-size: .88rem; }
    .social small { color: var(--muted); font-size: .75rem; }
    .arrow { color: #8f8588; }
    .contact-panel { text-align: center; padding: 42px 24px; background: radial-gradient(ellipse at 50% 0%, #ff263813, transparent 65%), rgba(255,255,255,.02); }
    .contact-panel p { color: var(--muted); margin: 14px 0 24px; }
    .email { display: inline-block; color: #ff6674; font-weight: 750; overflow-wrap: anywhere; }
    footer { border-top: 1px solid rgba(255,255,255,.08); padding: 25px 20px; color: #7f777a; font-size: .76rem; }
    .footer-inner { width: min(1120px, 100%); margin: auto; display: flex; justify-content: space-between; align-items: center; gap: 18px; }
    .footer-links { display: flex; gap: 18px; }
    .footer-links a:hover { color: var(--red); }
    .subscribe { position: fixed; right: 22px; bottom: 22px; z-index: 40; display: inline-flex; align-items: center; gap: 9px; padding: 13px 17px; border-radius: 999px; border: 1px solid #ff9aa4; background: linear-gradient(135deg, #ff3547, #a90017); box-shadow: 0 8px 35px #ff001c42, inset 0 1px 0 #ffffff55; font-size: .8rem; font-weight: 900; transition: transform .2s; }
    .subscribe:hover { transform: translateY(-4px) scale(1.03); }
    .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    @keyframes pulse { 50% { opacity: .35; box-shadow: 0 0 4px var(--red); } }
    @keyframes float { 0%,100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-12px) rotate(2deg); } }
    @keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
    @keyframes shine { 0%,65%,100% { transform: translateX(-120%); } 82% { transform: translateX(120%); } }
    @media (max-width: 800px) {
      nav { height: 68px; }
      .menu-btn { display: block; }
      .nav-links { display: none; position: absolute; top: 68px; left: 20px; right: 20px; padding: 18px; flex-direction: column; align-items: stretch; gap: 18px; border: 1px solid var(--line); border-radius: 16px; background: rgba(9,8,9,.97); }
