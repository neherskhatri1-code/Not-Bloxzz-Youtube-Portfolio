  <style>
    :root {
      --bg: #080808;
      --panel: rgba(20, 12, 14, .72);
      --red: #ff2638;
      --red2: #a90016;
      --text: #f8f5f5;
      --muted: #a7a0a2;
      --line: rgba(255, 45, 62, .24);
      --mx: 50%;
      --my: 50%;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 90px; }
    body {
      margin: 0; color: var(--text); background: var(--bg);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif;
      overflow-x: hidden;
    }
    body::before {
      content: ""; position: fixed; inset: 0; z-index: -3; pointer-events: none;
      background:
        radial-gradient(ellipse at 75% 20%, rgba(135, 0, 18, .24), transparent 38%),
        radial-gradient(ellipse at 10% 75%, rgba(255, 20, 40, .10), transparent 32%),
        linear-gradient(140deg, #090909 0%, #100709 48%, #050505 100%);
    }
    body::after {
      content: ""; position: fixed; inset: 0; z-index: -2; pointer-events: none; opacity: .15;
      background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: linear-gradient(to bottom, black, transparent 85%);
    }
    a { color: inherit; text-decoration: none; }
    button, a { -webkit-tap-highlight-color: transparent; }
    .cursor-glow {
      position: fixed; inset: 0; pointer-events: none; z-index: -1;
      background: radial-gradient(500px circle at var(--mx) var(--my), rgba(255, 25, 49, .08), transparent 55%);
    }
    .topline { height: 2px; background: linear-gradient(90deg, transparent, var(--red), transparent); }
    .nav-wrap { position: sticky; top: 0; z-index: 50; backdrop-filter: blur(18px); background: rgba(8,8,8,.76); border-bottom: 1px solid rgba(255,255,255,.07); }
    nav { width: min(1120px, calc(100% - 40px)); height: 76px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .brand { display: flex; align-items: center; gap: 12px; font-size: 1.12rem; font-weight: 850; letter-spacing: -.04em; }
    .brand img { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; border: 1px solid var(--red); box-shadow: 0 0 18px #ff26383b; }
    .brand span span { color: var(--red); }
    .nav-links { display: flex; align-items: center; gap: 28px; font-size: .84rem; color: #c6bec0; }
    .nav-links a { transition: color .2s; }
    .nav-links a:hover { color: var(--red); }
    .nav-cta { border: 1px solid rgba(255,38,56,.55); padding: 10px 16px; border-radius: 999px; color: #fff !important; background: rgba(255,38,56,.08); }
    .nav-cta:hover { background: var(--red); box-shadow: 0 0 24px #ff263844; }
    .menu-btn { display: none; background: none; border: 1px solid var(--line); color: white; padding: 9px 12px; border-radius: 10px; }
    main { width: min(1120px, calc(100% - 40px)); margin: auto; }
    .hero { min-height: calc(100svh - 78px); display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 54px; padding: 66px 0 84px; perspective: 1200px; }
    .eyebrow { display: inline-flex; align-items: center; gap: 9px; color: #ff8790; text-transform: uppercase; letter-spacing: .18em; font-size: .72rem; font-weight: 750; }
    .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--red); box-shadow: 0 0 13px var(--red); animation: pulse 1.7s infinite; }
    h1 { font-size: clamp(3.5rem, 8vw, 6.8rem); letter-spacing: -.085em; line-height: .9; margin: 25px 0 24px; font-weight: 950; }
    h1 .outline { color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.8); }
    h1 .red { color: var(--red); text-shadow: 0 0 38px rgba(255,0,30,.23); }
    .intro { color: #b6afb1; font-size: 1.03rem; line-height: 1.8; max-width: 500px; }
    .intro strong { color: white; font-weight: 650; }
    .actions { display: flex; gap: 13px; flex-wrap: wrap; margin-top: 30px; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 14px 19px; border-radius: 12px; font-size: .9rem; font-weight: 800; border: 1px solid transparent; transition: transform .25s, box-shadow .25s, background .25s; }
    .btn:hover { transform: translateY(-3px); }
    .btn-primary { background: linear-gradient(135deg, #ff3445, #bd001b); box-shadow: 0 9px 30px #ff263826, inset 0 1px 0 #ffffff48; }
    .btn-primary:hover { box-shadow: 0 12px 38px #ff26385c; }
    .btn-secondary { border-color: rgba(255,255,255,.15); background: rgba(255,255,255,.035); }
    .btn-secondary:hover { border-color: var(--red); background: #ff263810; }
    .meta { display: flex; align-items: center; gap: 18px; margin-top: 34px; color: #777174; font-size: .76rem; }
    .meta span { display: inline-flex; align-items: center; gap: 7px; }
    .meta b { color: #f5eeee; font-weight: 700; }
    .meta .dot { width: 3px; height: 3px; background: #51474a; border-radius: 50%; }
    .visual { min-height: 470px; position: relative; display: grid; place-items: center; isolation: isolate; }
    .orb { position: absolute; width: min(420px, 95%); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 35% 25%, #ff293b 0%, #7d0012 24%, #1a070a 57%, #080808 72%); filter: drop-shadow(0 0 42px #ff10232b); animation: float 7s ease-in-out infinite; }
    .orb::before { content: ""; position: absolute; inset: -15px; border-radius: 50%; border: 1px solid rgba(255,54,73,.35); transform: rotateX(68deg) rotateZ(-20deg); box-shadow: 0 0 30px #ff102318; }
    .orb::after { content: ""; position: absolute; inset: 13px; border-radius: 50%; border: 1px dashed rgba(255,100,112,.3); transform: rotateX(68deg) rotateZ(30deg); }
    .avatar-card {
      position: relative; z-index: 2; width: min(370px, 85%); aspect-ratio: 1 / 1.08;
      display: grid; place-items: center; transform-style: preserve-3d; transform: rotateY(-9deg) rotateX(4deg);
      transition: transform .15s ease-out; border: 1px solid rgba(255,67,83,.4); border-radius: 30px;
      background: linear-gradient(145deg, rgba(255,255,255,.09), rgba(255,255,255,.015) 45%, rgba(255,0,30,.07));
      box-shadow: 22px 28px 70px #000b, 0 0 55px #ff00151b, inset 0 1px 0 #ffffff26; overflow: hidden;
      backdrop-filter: blur(12px);
    }
    .avatar-card::before { content: ""; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 20%, #ffffff13 36%, transparent 50%); transform: translateX(-120%); animation: shine 6s ease-in-out infinite; }
    .avatar-card img { width: 94%; height: 94%; object-fit: contain; filter: drop-shadow(0 15px 28px #000); transform: translateZ(45px); }
    .floating-tag { position: absolute; z-index: 4; padding: 11px 14px; border: 1px solid rgba(255,64,80,.35); background: rgba(12,8,9,.82); backdrop-filter: blur(14px); border-radius: 12px; box-shadow: 0 12px 35px #0008; font-size: .76rem; font-weight: 750; }
    .floating-tag small { display: block; color: #8d8285; font-size: .63rem; margin-bottom: 4px; font-weight: 600; }
    .tag-top { top: 11%; right: -2%; animation: bob 5s ease-in-out infinite; }
    .tag-bottom { bottom: 10%; left: -1%; animation: bob 5s ease-in-out infinite reverse; }
    .spark { position: absolute; width: 5px; height: 5px; background: #ff4355; border-radius: 50%; box-shadow: 0 0 15px 3px #ff2638; }
    .s1 { top: 16%; left: 12%; } .s2 { right: 12%; bottom: 20%; width: 3px; height: 3px; }
    .section { padding: 85px 0; }
    .section-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
    .kicker { color: var(--red); text-transform: uppercase; letter-spacing: .18em; font-size: .7rem; font-weight: 800; }
    h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1; letter-spacing: -.06em; margin: 12px 0 0; }
    .section-head p { color: var(--muted); max-width: 400px; line-height: 1.7; font-size: .9rem; margin: 0; }
    .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .card { position: relative; padding: 25px; border: 1px solid rgba(255,255,255,.09); border-radius: 20px; background: linear-gradient(145deg, rgba(255,255,255,.055), rgba(255,255,255,.015)); min-height: 190px; transform-style: preserve-3d; transition: border-color .25s, background .25s, transform .25s; overflow: hidden; }
    .card::after { content: ""; position: absolute; width: 150px; height: 150px; border-radius: 50%; background: #ff26380d; filter: blur(35px); right: -70px; bottom: -80px; pointer-events: none; }
    .card:hover { border-color: rgba(255,38,56,.45); background: linear-gradient(145deg, rgba(255,38,56,.09), rgba(255,255,255,.02)); }
    .card-icon { width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid #ff26384d; background: #ff263811; color: var(--red); border-radius: 13px; margin-bottom: 23px; }
